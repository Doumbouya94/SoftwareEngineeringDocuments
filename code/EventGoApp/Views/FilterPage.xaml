<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventGoApp.ViewModels"
             x:Class="EventGoApp.Views.FilterPage"
             x:DataType="vm:FilterViewModel"
             BackgroundColor="White"
             Title="Filtres"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
        <!-- Simple Header for Title and Reset -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,20">
            <Label Grid.Column="0" Text="Filtres" FontSize="24" FontAttributes="Bold" FontFamily="OswaldBold" TextColor="Black" VerticalOptions="Center"/>
            <Label Grid.Column="1" Text="Réinitialiser" TextColor="#6200EE" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ResetCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24">
                
                <!-- City Filter -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ville" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                    <Border Stroke="#D1C4E9" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,4">
                        <Picker ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" TextColor="Black"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Price Filter -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Budget maximum" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                        <Label Grid.Column="1" Text="{Binding FormattedMaxPrice}" TextColor="#6200EE" FontAttributes="Bold"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="100" Value="{Binding MaxPrice}" MinimumTrackColor="#6200EE" MaximumTrackColor="#D1C4E9" ThumbColor="#6200EE"/>
                </VerticalStackLayout>

                <!-- Category Filter -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Catégorie" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="Plus de filtres bientôt disponible..." FontSize="14" TextColor="#666666" FontAttributes="Italic"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,20,0,0">
            <Button Grid.Column="0" 
                    Text="Fermer" 
                    Command="{Binding BackCommand}"
                    BackgroundColor="Transparent" 
                    TextColor="Black" 
                    BorderColor="Black"
                    BorderWidth="1"
                    FontAttributes="Bold" 
                    CornerRadius="25" 
                    HeightRequest="50"/>

            <Button Grid.Column="1" 
                    Text="Appliquer" 
                    Command="{Binding ApplyCommand}"
                    BackgroundColor="Black" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="25" 
                    HeightRequest="50"/>
        </Grid>

    </Grid>
</ContentPage>
