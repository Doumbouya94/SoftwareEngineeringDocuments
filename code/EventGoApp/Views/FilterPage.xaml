<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventGoApp.ViewModels"
             x:Class="EventGoApp.Views.FilterPage"
             x:DataType="vm:FilterViewModel"
             BackgroundColor="White"
             Title="Filtres"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">
        
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,20" ColumnSpacing="12">
            <Border Grid.Column="0" 
                    BackgroundColor="White" 
                    Stroke="#D1C4E9" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 20" 
                    WidthRequest="40" 
                    HeightRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}"/>
                </Border.GestureRecognizers>
                <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" 
                      Fill="Black" 
                      HorizontalOptions="Center" 
                      VerticalOptions="Center" 
                      WidthRequest="24" 
                      HeightRequest="24" 
                      Aspect="Uniform"/>
            </Border>
            <Label Grid.Column="1" Text="Filtres" FontSize="24" FontAttributes="Bold" FontFamily="OswaldBold" TextColor="Black" VerticalOptions="Center"/>
            <Label Grid.Column="2" Text="Réinitialiser" TextColor="#6200EE" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ResetCommand}"/>
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="24">
                
                <!-- City Filter -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ville" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                    <Border Stroke="#D1C4E9" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,4">
                        <Picker ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" TextColor="Black"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Price Filter -->
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0" Text="Budget maximum" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                        <Label Grid.Column="1" Text="{Binding FormattedMaxPrice}" TextColor="#6200EE" FontAttributes="Bold"/>
                    </Grid>
                    <Slider Minimum="0" Maximum="100" Value="{Binding MaxPrice}" MinimumTrackColor="#6200EE" MaximumTrackColor="#D1C4E9" ThumbColor="#6200EE"/>
                </VerticalStackLayout>

                <!-- Category Filter -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Catégorie" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="Plus de filtres bientôt disponible..." FontSize="14" TextColor="#666666" FontAttributes="Italic"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Button -->
        <Button Grid.Row="2" 
                Text="Appliquer les filtres" 
                Command="{Binding ApplyCommand}"
                BackgroundColor="Black" 
                TextColor="White" 
                FontAttributes="Bold" 
                CornerRadius="25" 
                HeightRequest="50"
                Margin="0,20,0,0"/>

    </Grid>
</ContentPage>
