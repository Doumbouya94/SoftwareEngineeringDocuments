<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventGoApp.ViewModels"
             xmlns:models="clr-namespace:EventGoApp.Models"
             xmlns:conv="clr-namespace:EventGoApp.Converters"
             x:Class="EventGoApp.Views.TicketsPage"
             x:DataType="vm:TicketsViewModel"
             Title="Tickets"
             BackgroundColor="White">

    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="0">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,20,20,8" Spacing="4">
            <Label Text="Mes billets"
                   FontSize="28"
                   FontAttributes="Bold"
                   FontFamily="OswaldBold"
                   TextColor="Black"/>
            <Label Text="Vos billets achetés apparaissent ici."
                   FontSize="14"
                   TextColor="#666666"/>
        </VerticalStackLayout>

        <!-- Empty state -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsEmpty}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12"
                             Padding="40,0">
            <Label Text="🎟️" FontSize="60" HorizontalOptions="Center"/>
            <Label Text="Aucun billet pour le moment"
                   FontSize="18" FontAttributes="Bold"
                   TextColor="#666666" HorizontalOptions="Center"/>
            <Label Text="Participez à un événement pour voir vos billets ici."
                   FontSize="14" TextColor="#999999"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Vertical stack -->
        <CollectionView Grid.Row="1"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}"
                        ItemsSource="{Binding Tickets}"
                        SelectionMode="None"
                        Margin="0,8,0,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Ticket">
                    <Border Margin="20,0"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="#E0E0E0"
                            BackgroundColor="White">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.08"/>
                        </Border.Shadow>

                        <Grid RowDefinitions="160, 1, Auto, Auto, 1, Auto">

                            <!-- Event image -->
                            <Image Grid.Row="0"
                                   Source="{Binding EventImageSource}"
                                   Aspect="AspectFill"
                                   BackgroundColor="#F0E6FF"/>

                            <BoxView Grid.Row="1" BackgroundColor="#E0E0E0"/>

                            <!-- Event info -->
                            <VerticalStackLayout Grid.Row="2" Padding="16,12" Spacing="4">
                                <Label Text="{Binding EventTitle}"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="Black" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding EventDate, StringFormat='{0:ddd d MMM yyyy}'}"
                                       FontSize="13" TextColor="#666666"/>
                                <Label Text="{Binding EventVenue}"
                                       FontSize="13" TextColor="#999999"
                                       LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>

                            <!-- Quantity badge -->
                            <Border Grid.Row="3"
                                    Margin="16,0,16,12" Padding="10,6"
                                    StrokeShape="RoundRectangle 8"
                                    BackgroundColor="#F5F0FF"
                                    StrokeThickness="0"
                                    HorizontalOptions="Start">
                                <Label TextColor="#6200EE" FontSize="13" FontAttributes="Bold">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Quantity}"/>
                                            <Span Text=" billet(s)"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Border>

                            <BoxView Grid.Row="4" BackgroundColor="#E0E0E0" Margin="16,0"/>

                            <!-- Barcode -->
                            <Image Grid.Row="5"
                                   Source="{Binding BarcodeUrl}"
                                   HeightRequest="70"
                                   Aspect="AspectFit"
                                   Margin="16,12,16,16"/>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="Black" VerticalOptions="End"/>
    </Grid>
</ContentPage>
