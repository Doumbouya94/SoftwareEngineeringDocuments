<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventGoApp.ViewModels"
             xmlns:models="clr-namespace:EventGoApp.Models"
             x:Class="EventGoApp.Views.FavoritesPage"
             Title="Favoris"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" Padding="20,20,20,12" BackgroundColor="White">
            <Label Text="Mes Favoris"
                   FontSize="24"
                   FontAttributes="Bold"
                   FontFamily="OswaldBold"
                   TextColor="Black"/>
        </Grid>

        <!-- Liste vide -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="12"
                             IsVisible="{Binding IsEmpty}">
            <Label Text="❤️" FontSize="60" HorizontalOptions="Center"/>
            <Label Text="Aucun favori pour l'instant"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="Black"/>
            <Label Text="Appuyez sur ❤️ sur un événement pour l'ajouter"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="Gray"/>
        </VerticalStackLayout>

        <!-- Liste des favoris -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Favorites}"
                        IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}"
                        SelectionMode="Single"
                        SelectionChanged="OnEventSelected"
                        Margin="0,0,0,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Event">
                    <Grid Padding="16,0">
                        <Border BackgroundColor="White"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Black"
                                StrokeThickness="1"
                                Padding="12">
                            <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="12">

                                <!-- Image Thumbnail -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        BackgroundColor="{Binding ImagePlaceholderColor}"
                                        WidthRequest="70"
                                        HeightRequest="70"
                                        VerticalOptions="Center">
                                    <Image Source="{Binding ImageSource}" 
                                           Aspect="AspectFill"/>
                                </Border>

                                <!-- Text Informations -->
                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" VerticalOptions="Center">
                                    <Label Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           LineBreakMode="TailTruncation"/>

                                    <Label Grid.Row="1"
                                           Text="{Binding Date, StringFormat='{0:ddd d MMM yyyy · HH:mm}'}"
                                           FontSize="13"
                                           TextColor="Gray"/>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                        <Label Grid.Column="0"
                                               Text="{Binding City}"
                                               FontSize="13"
                                               TextColor="Black"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding Price, StringFormat='{0:0.##} $'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="Black"/>
                                    </Grid>
                                </Grid>

                                <!-- Bouton retirer -->
                                <Button Grid.Column="2"
                                        Text="❤️"
                                        FontSize="20"
                                        BackgroundColor="Transparent"
                                        TextColor="Red"
                                        VerticalOptions="Start"
                                        Padding="0"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        Clicked="OnRemoveFavoriteClicked"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bouton Undo -->
        <Button Grid.Row="2"
                Text="↩ Annuler la dernière action"
                BackgroundColor="Black"
                TextColor="White"
                Margin="16,8,16,16"
                CornerRadius="12"
                IsEnabled="{Binding CanUndo}"
                Clicked="OnUndoClicked"/>

        <!-- Séparateur -->
        <BoxView Grid.Row="2" HeightRequest="1" BackgroundColor="Black" VerticalOptions="Start"/>

    </Grid>

</ContentPage>