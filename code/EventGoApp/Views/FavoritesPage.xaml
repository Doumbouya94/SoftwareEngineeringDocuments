<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EventGoApp.Views.FavoritesPage"
             Title="Favoris"
             BackgroundColor="White">
    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
            <Label Text="❤️" FontSize="60" HorizontalOptions="Center"/>
            <Label Text="Vos Favoris" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
            <Label Text="Pas de favoris en ce moment !" HorizontalOptions="Center" TextColor="Gray"/>
        </VerticalStackLayout>
        <BoxView HeightRequest="1" BackgroundColor="Black" VerticalOptions="End"/>
    </Grid>
</ContentPage>