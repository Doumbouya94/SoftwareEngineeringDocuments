<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventGoApp.ViewModels"
             x:Class="EventGoApp.Views.HomePage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Top bar -->
        <Grid Grid.Row="0" Padding="20,20,20,12" ColumnDefinitions="*,Auto" BackgroundColor="White">
            <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                <Label x:Name="SubtitleLabel"
                       Text="Bonjour !"
                       FontSize="22"
                       FontAttributes="Bold"
                       FontFamily="OswaldBold"
                       TextColor="Black"/>
                <HorizontalStackLayout Spacing="4" Margin="0,-2,0,0">
                    <Path Data="M12,2C8.13,2 5,5.13 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9C19,5.13 15.87,2 12,2M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5Z" 
                          Fill="Black" 
                          WidthRequest="16" 
                          HeightRequest="16" 
                          VerticalOptions="Center" 
                          Aspect="Uniform"/>
                    <Label Text="Montréal"
                           FontSize="16"
                           FontFamily="OswaldRegular"
                           TextColor="Black"
                           VerticalOptions="Center"/>
                    <Path Data="M7,10L12,15L17,10H7Z" 
                          Fill="Black" 
                          WidthRequest="14" 
                          HeightRequest="14" 
                          VerticalOptions="Center" 
                          Aspect="Uniform"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Border Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="Black"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    WidthRequest="44"
                    HeightRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLogoutClicked"/>
                </Border.GestureRecognizers>
                <Path Data="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z"
                      Fill="Black"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="20"
                      HeightRequest="20"
                      Aspect="Uniform"/>
            </Border>
        </Grid>

        <!-- Search Bar Area -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="*,Auto" 
              Margin="16,0,16,12" 
              ColumnSpacing="10">
            
            <Border Grid.Column="0"
                    Padding="0"
                    StrokeShape="RoundRectangle 25"
                    Stroke="Black"
                    StrokeThickness="1"
                    BackgroundColor="White">
                <SearchBar Placeholder="Rechercher un événement..."
                           PlaceholderColor="#9E9E9E"
                           TextColor="#2D1B4E"
                           CancelButtonColor="#6200EE"
                           BackgroundColor="Transparent"
                           FontSize="14"/>
            </Border>

            <Border Grid.Column="1"
                    BackgroundColor="White"
                    Stroke="Black"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    WidthRequest="48"
                    HeightRequest="48">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFilterClicked"/>
                </Border.GestureRecognizers>
                <Path Data="M10,18H14V16H10V18M3,6V8H21V6H3M6,13H18V11H6V13Z"
                      Fill="Black"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="20"
                      HeightRequest="20"
                      Aspect="Uniform"/>
            </Border>
        </Grid>

        <!-- Filter pills -->
        <ScrollView Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Padding="12,0,12,12"
                    BackgroundColor="White">
            <HorizontalStackLayout x:Name="FilterPillsLayout" Spacing="8"/>
        </ScrollView>

        <!-- Event list -->
        <CollectionView Grid.Row="3"
                        x:Name="EventsCollection"
                        Margin="0,0,0,0"
                        SelectionMode="Single"
                        SelectionChanged="OnEventSelected">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:EventViewModel">
                    <Grid Padding="16,0">
                        <Border BackgroundColor="White"
                                StrokeShape="RoundRectangle 12"
                                Stroke="Black"
                                StrokeThickness="1"
                                HeightRequest="280">
                            <!-- Content -->
                            <Grid RowDefinitions="180,*">
                                <!-- Image or placeholder -->
                                <BoxView Grid.Row="0" 
                                         Color="{Binding ImagePlaceholderColor}" 
                                         CornerRadius="12,12,0,0"
                                         IsVisible="{Binding HasImage, Converter={StaticResource InverseBoolConverter}}"/>

                                <Image Grid.Row="0"
                                       Source="{Binding ImageSource}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasImage}"/>
                                
                                <!-- Featured badge -->
                                <Border Grid.Row="0"
                                        BackgroundColor="#CC000000"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Start"
                                        Margin="12,12,0,0"
                                        Padding="8,4"
                                        IsVisible="{Binding IsFeatured}">
                                    <Label Text="⭐ À la une"
                                           TextColor="White"
                                           FontSize="11"
                                           FontAttributes="Bold"/>
                                </Border>

                                <!-- Category badge -->
                                <Border Grid.Row="0"
                                        BackgroundColor="#CC000000"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="0,12,12,0"
                                        Padding="8,4">
                                    <Label Text="{Binding CategoryLabel}"
                                           TextColor="White"
                                           FontSize="11"/>
                                </Border>

                                <!-- Info panel -->
                                <Grid Grid.Row="1" 
                                      RowDefinitions="Auto,Auto,Auto" 
                                      RowSpacing="4" 
                                      Padding="12,10">
                                    <Label Grid.Row="0"
                                           Text="{Binding Title}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Row="1"
                                           Text="{Binding FormattedDate}"
                                           FontSize="13"
                                           TextColor="Black"
                                           FontAttributes="Bold"/>
                                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding City}"
                                               FontSize="13"
                                               TextColor="Black"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding FormattedPrice}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="Black"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- TabBar Separator -->
        <BoxView Grid.Row="3" HeightRequest="1" BackgroundColor="Black" VerticalOptions="End"/>

        <!-- FAB Button -->
        <Border Grid.Row="3"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,20"
                BackgroundColor="Black"
                WidthRequest="60"
                HeightRequest="60"
                StrokeShape="RoundRectangle 30"
                StrokeThickness="0"
                ZIndex="10">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.3"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCreateEventClicked"/>
            </Border.GestureRecognizers>
            <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
                  Fill="White"
                  WidthRequest="30"
                  HeightRequest="30"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Aspect="Uniform"/>
        </Border>

    </Grid>

</ContentPage>
