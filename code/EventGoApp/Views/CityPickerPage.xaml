<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventGoApp.ViewModels"
             x:Class="EventGoApp.Views.CityPickerPage"
             x:DataType="vm:CityPickerViewModel"
             Title="Choisir une ville"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20">

        <!-- Titre -->
        <Label Grid.Row="0"
               Text="Où voulez-vous explorer ?"
               FontSize="22"
               FontAttributes="Bold"
               FontFamily="OswaldBold"
               TextColor="Black"
               Margin="0,0,0,20"/>

        <!-- Bouton Détecter positionnement -->
        <Border Grid.Row="1"
                Stroke="Black"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                Padding="16,14"
                Margin="0,0,0,20">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DetectLocationCommand}"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Grid.Column="0"
                      Data="M12,2C8.13,2 5,5.13 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9C19,5.13 15.87,2 12,2M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5Z"
                      Fill="Black"
                      WidthRequest="20"
                      HeightRequest="20"
                      Aspect="Uniform"
                      VerticalOptions="Center"
                      Margin="0,0,12,0"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Détecter mon positionnement"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="Black"/>
                    <Label Text="{Binding DetectionStatus}"
                           FontSize="12"
                           TextColor="Gray"
                           IsVisible="{Binding DetectionStatus, Converter={StaticResource StringToBoolConverter}}"/>
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="2"
                                   IsRunning="{Binding IsDetecting}"
                                   IsVisible="{Binding IsDetecting}"
                                   Color="Black"
                                   WidthRequest="24"
                                   HeightRequest="24"/>
            </Grid>
        </Border>

        <!-- Liste des villes -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Cities}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Stroke="#EEEEEE"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="White"
                            Padding="16,14"
                            Margin="0,0,0,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CityPickerViewModel}}, Path=SelectCityCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{Binding .}"
                               FontSize="16"
                               TextColor="Black"
                               FontAttributes="Bold"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>